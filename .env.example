# Public Supabase values used by the browser client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never expose these with a NEXT_PUBLIC_ prefix.

# Supabase secret key (Settings -> API Keys). Bypasses RLS, so server-side only.
# Required for OAuth connections, extension pairing and imports.
SUPABASE_SECRET_KEY=

# Encrypts stored OAuth tokens at rest. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Base URL of this app. Must match the redirect URI registered with Google.
APP_URL=http://localhost:3000

# Google OAuth client (Web application) with the YouTube Data API v3 enabled.
# Authorized redirect URI: ${APP_URL}/api/connect/youtube/callback
# Optional: leave blank to run everything except the YouTube connector.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Protects maintenance endpoints. Generate with: openssl rand -hex 32
CRON_SECRET=
