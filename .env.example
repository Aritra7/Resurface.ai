# Public Supabase values used by the browser client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never expose these with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Optional enrichment providers. Ingestion falls back gracefully when unset:
# YouTube uses oEmbed instead of the Data API (no video duration), Instagram
# uses a labeled placeholder title instead of oEmbed metadata.
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
